# ----- API Keys -----
FUGLE_API_KEY=your_fugle_api_key_here
FINMIND_TOKEN=your_finmind_token_here

# ----- Discord -----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# ----- Runtime -----
TZ=Asia/Taipei
LOG_LEVEL=INFO

# ----- Screener thresholds (盤前篩選) -----
SCREENER_LOOKBACK_DAYS=20
SCREENER_MIN_AVG_VOLUME_LOTS=10000      # 平均成交量 > 1萬張
SCREENER_MIN_TURNOVER_RATE=0.02         # 週轉率 (成交張 / 流通股數) >= 2%
SCREENER_MIN_ATR_PCT=0.025              # ATR(14) / Close >= 2.5%  (高波動)
SCREENER_PRICE_MIN=10.0
SCREENER_PRICE_MAX=500.0
SCREENER_TOP_N=30
